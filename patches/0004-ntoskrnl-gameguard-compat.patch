+/***********************************************************************
+ *           SeCaptureSecurityDescriptor   (NTOSKRNL.EXE.@)
+ *
+ * Compatibility implementation for self-relative security descriptors.
+ * Absolute descriptor capture is intentionally left unsupported until
+ * its complete semantics are implemented.
+ */
+NTSTATUS WINAPI SeCaptureSecurityDescriptor(
+        PSECURITY_DESCRIPTOR original,
+        KPROCESSOR_MODE mode,
+        POOL_TYPE pool_type,
+        BOOLEAN capture_if_kernel,
+        PSECURITY_DESCRIPTOR *captured )
+{
+    SECURITY_DESCRIPTOR *sd = original;
+    PSECURITY_DESCRIPTOR copy;
+    ULONG size;
+
+    TRACE( "original %p mode %u pool_type %u capture_if_kernel %u captured %p.\n",
+           original, mode, pool_type, capture_if_kernel, captured );
+
+    if (!captured)
+        return STATUS_INVALID_PARAMETER;
+
+    *captured = NULL;
+
+    if (!original)
+        return STATUS_SUCCESS;
+
+    /*
+     * Windows keeps the original kernel descriptor when capture was not
+     * explicitly requested.  Revision validation is still performed.
+     */
+    if (mode == KernelMode && !capture_if_kernel)
+    {
+        if (sd->Revision != 1)
+            return STATUS_UNKNOWN_REVISION;
+
+        *captured = original;
+        return STATUS_SUCCESS;
+    }
+
+    if (sd->Revision != 1)
+        return STATUS_UNKNOWN_REVISION;
+
+    if (!RtlValidSecurityDescriptor( original ))
+        return STATUS_INVALID_SECURITY_DESCR;
+
+    /*
+     * The complete Windows routine also converts absolute descriptors
+     * into newly allocated self-relative descriptors.  Do not fake that
+     * behaviour.  The GG WDMSEC path currently observed supplies an
+     * already self-relative descriptor.
+     */
+    if (!(sd->Control & SE_SELF_RELATIVE))
+    {
+        FIXME( "absolute security descriptor capture is not implemented.\n" );
+        return STATUS_NOT_IMPLEMENTED;
+    }
+
+    size = RtlLengthSecurityDescriptor( original );
+    if (!size)
+        return STATUS_INVALID_SECURITY_DESCR;
+
+    copy = ExAllocatePoolWithTag( pool_type, size, 0 );
+    if (!copy)
+        return STATUS_INSUFFICIENT_RESOURCES;
+
+    memcpy( copy, original, size );
+
+    *captured = copy;
+
+    return STATUS_SUCCESS;
+}
+
